---
import CornerRadiusSlider from './isles/CornerRadiusSlider';
import SyncVisualizer from './isles/SyncVisualizer';
import ErgonomicsToggle from './isles/ErgonomicsToggle';
import HapticsWaveVisualizer from './isles/HapticsWaveVisualizer';
import InteractiveChart from './isles/InteractiveChart';
import { TrendingUp, Sliders, Zap, Vibrate, ShieldCheck, Heart, Sparkles, Compass } from 'lucide-react';
---

<div id="features" class="relative">
  
  <!-- Chapter 1: Telemetry & Visualizing Progress -->
  <section id="telemetry" class="min-h-screen py-24 sm:py-32 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-900">
    <div class="max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Story Copy -->
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Watch your dedication take <span class="em-serif text-amber-400 text-4xl sm:text-6xl md:text-7xl">shape</span>.
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            Counting isn't just about the current number; it's about seeing the quiet arc of your discipline. Keisuki translates raw taps into calm, elegant rhythms across days, weeks, and seasons.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 flex-shrink-0 mt-0.5">
                <TrendingUp className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Smooth Time Scrubbing</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Glide across days and hours with fluid cursor and touch inspection to see when you were most focused.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-ruby-500/10 text-ruby-400 flex-shrink-0 mt-0.5">
                <Sparkles className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Quiet, Meaningful Insights</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Active streaks and average velocity presented cleanly, with zero gamified guilt or annoying badges.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Widget -->
        <div class="lg:col-span-6">
          <InteractiveChart client:visible />
        </div>

      </div>
    </div>
  </section>


  <!-- Chapter 2: Tactile Geometry & Expressive Shapes -->
  <section class="min-h-screen py-24 sm:py-32 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-950">
    <div class="max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Interactive Widget (Left on desktop) -->
        <div class="lg:col-span-6 order-2 lg:order-1">
          <CornerRadiusSlider client:visible />
        </div>

        <!-- Story Copy (Right on desktop) -->
        <div class="lg:col-span-6 space-y-6 order-1 lg:order-2">
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Crafted to feel <span class="em-serif text-ruby-400 text-4xl sm:text-6xl md:text-7xl">natural</span> in your palm.
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            Soft curves and organic geometry that mirror the physical objects you enjoy holding. Adjust the radius in real-time to match your personal aesthetic—from sharp architectural lines to pillowy curves.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-ruby-500/10 text-ruby-400 flex-shrink-0 mt-0.5">
                <Sliders className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Harmonious Proportions</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  A unified corner curvature algorithm dynamically scales every card, button, bottom sheet, and dialog.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 flex-shrink-0 mt-0.5">
                <Heart className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">True Black Serenity</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Pitch-black AMOLED mode rests gently on your eyes during quiet evening reflection and meditation.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Chapter 3: Instant Speed & Unbroken Flow -->
  <section class="min-h-screen py-24 sm:py-32 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-900">
    <div class="max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Story Copy -->
        <div class="lg:col-span-6 space-y-6">
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            Never wait on a <span class="em-serif text-amber-400 text-4xl sm:text-6xl md:text-7xl">spinner</span> again.
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            Software should move at the exact speed of human intention. With zero network delays on every tap and thoughtful ergonomics, your flow state remains completely uninterrupted.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 flex-shrink-0 mt-0.5">
                <Zap className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Instant Local Memory</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Your counts commit to on-device silicon in zero milliseconds, while cloud sync waits peacefully in the background.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 flex-shrink-0 mt-0.5">
                <Compass className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Single-Handed Harmony</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Primary touch targets adapt for natural thumb reach, making single-handed counting effortless on any screen size.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Interactive Widgets Grid -->
        <div class="lg:col-span-6 space-y-6">
          <SyncVisualizer client:visible />
          <ErgonomicsToggle client:visible />
        </div>

      </div>
    </div>
  </section>


  <!-- Chapter 4: Tactile Physicality & Meaningful Haptics -->
  <section class="min-h-screen py-24 sm:py-32 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-950">
    <div class="max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Interactive Widget (Left on desktop) -->
        <div class="lg:col-span-6 order-2 lg:order-1">
          <HapticsWaveVisualizer client:visible />
        </div>

        <!-- Story Copy (Right on desktop) -->
        <div class="lg:col-span-6 space-y-6 order-1 lg:order-2">
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.15]">
            The satisfying <span class="em-serif text-ruby-400 text-4xl sm:text-6xl md:text-7xl">pulse</span> of accomplishment.
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            Digital counters often feel hollow and disconnected. Keisuki restores the satisfying mechanical presence of classic tally counters with finely tuned vibrational pulses that confirm every milestone.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-ruby-500/10 text-ruby-400 flex-shrink-0 mt-0.5">
                <Vibrate className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Tactile Precision</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Distinct physical sensations for swift ticks, solid clicks, and heavy threshold confirmations.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
              <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 flex-shrink-0 mt-0.5">
                <Sparkles className="w-4 h-4" />
              </div>
              <div>
                <h3 class="text-sm font-bold text-white mb-1">Eyes-Free Certainty</h3>
                <p class="text-xs text-zinc-400 leading-relaxed">
                  Tally repetitions, laps, and chants with absolute tactile assurance without ever glancing at your screen.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- Chapter 5: Privacy Sovereignty Banner -->
  <section class="py-24 px-4 sm:px-8 border-t border-white/5 bg-obsidian-900">
    <div class="max-w-4xl mx-auto">
      <div class="p-8 sm:p-12 rounded-3xl glass-panel border border-white/10 bg-obsidian-850 text-center space-y-6">
        <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 mx-auto">
          <ShieldCheck className="w-7 h-7" />
        </div>

        <h3 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
          Your journey is <span class="em-serif text-amber-400 text-3xl sm:text-5xl">yours</span> alone.
        </h3>

        <p class="text-sm sm:text-base text-zinc-400 max-w-xl mx-auto leading-relaxed">
          No trackers, no surveillance, no third-party data broker SDKs. Everything you count stays on your device in your private local SQLite database.
        </p>

        <div class="pt-2">
          <a
            href="/privacy"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-semibold text-white transition-all hover:border-white/20"
          >
            <span>Read Data Sovereignty Pledge</span>
          </a>
        </div>
      </div>
    </div>
  </section>

</div>
