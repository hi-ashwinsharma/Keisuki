---
import { Download, Terminal, Smartphone } from 'lucide-react';
---

<section id="download" class="py-24 px-4 sm:px-6 relative border-t border-white/5 bg-obsidian-950">
  <div class="max-w-4xl mx-auto">
    <!-- Header (No pills above) -->
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Experience <span class="em-serif text-amber-400 text-4xl sm:text-6xl">Keisuki</span> on your device.
      </h2>
      <p class="text-sm sm:text-base text-zinc-400">
        Choose your preferred distribution channel or compile directly from the open source repository.
      </p>
    </div>

    <!-- Download Options Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      
      <!-- GitHub Release Card (Solid background, no gradient) -->
      <div class="p-7 rounded-3xl glass-panel border border-ruby-500/30 bg-obsidian-850 flex flex-col justify-between relative group hover:border-ruby-500/50 transition-all">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold text-ruby-400">Direct APK Download</span>
            <span class="text-xs text-zinc-500 num-mono">Latest v1.0.0</span>
          </div>

          <h3 class="text-xl font-bold text-white mb-2">Android Release APK</h3>
          <p class="text-xs text-zinc-400 leading-relaxed mb-6">
            Signed production build with full offline support, custom Canvas telemetry, and Material 3 Expressive theming.
          </p>
        </div>

        <div>
          <a
            href="https://github.com/hi-ashwinsharma/Keisuki/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3 rounded-2xl bg-ruby-500 hover:bg-ruby-600 text-white font-bold text-xs transition-all flex items-center justify-center gap-2 active:scale-95"
          >
            <Download className="w-4 h-4" />
            <span>Download APK (Release)</span>
          </a>
          <span class="block text-center text-[10px] text-zinc-500 mt-2.5">
            Requires Android 8.0 (API 26) or higher
          </span>
        </div>
      </div>

      <!-- Google Play Card -->
      <div class="p-7 rounded-3xl glass-panel border border-white/10 bg-obsidian-850 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold text-amber-400">Google Play Store</span>
            <span class="text-xs text-zinc-500 num-mono">Review in Progress</span>
          </div>

          <h3 class="text-xl font-bold text-white mb-2">Google Play Edition</h3>
          <p class="text-xs text-zinc-400 leading-relaxed mb-6">
            Automated updates via Google Play Store. Target SDK 35 (Android 15) compliant with Google Credential Manager integration.
          </p>
        </div>

        <div>
          <button
            disabled
            class="w-full py-3 rounded-2xl bg-white/5 border border-white/10 text-zinc-400 font-semibold text-xs cursor-not-allowed flex items-center justify-center gap-2"
          >
            <Smartphone className="w-4 h-4 text-zinc-500" />
            <span>Coming Soon to Play Store</span>
          </button>
          <span class="block text-center text-[10px] text-zinc-500 mt-2.5">
            Pre-registration launching soon
          </span>
        </div>
      </div>

    </div>

    <!-- Build from Source Code Snippet -->
    <div class="p-6 rounded-3xl glass-panel border border-white/10 bg-obsidian-900">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-white/5">
        <div class="flex items-center gap-2">
          <Terminal className="w-4 h-4 text-amber-400" />
          <span className="text-xs font-bold text-white">Build from Source</span>
        </div>
        <span class="text-[11px] text-zinc-500 num-mono">JDK 17 • Gradle 8.7</span>
      </div>

      <div class="bg-obsidian-950 p-4 rounded-2xl font-mono text-xs text-zinc-300 overflow-x-auto space-y-1.5 border border-white/5">
        <div class="text-zinc-500"># 1. Clone repository</div>
        <div class="text-amber-300">git clone https://github.com/hi-ashwinsharma/Keisuki.git</div>
        <div class="text-zinc-500 mt-2"># 2. Navigate to Android project</div>
        <div class="text-amber-300">cd Keisuki/android</div>
        <div class="text-zinc-500 mt-2"># 3. Assemble debug APK</div>
        <div class="text-emerald-400">./gradlew assembleDebug</div>
      </div>
    </div>

  </div>
</section>
