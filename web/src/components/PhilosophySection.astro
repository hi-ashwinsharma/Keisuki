---
import InteractiveCounterDemo from './isles/InteractiveCounterDemo';
---

<section id="showcase" class="min-h-[92vh] py-28 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-950/40">
  <div class="max-w-7xl mx-auto w-full">
    <!-- Story Hook Header -->
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight mb-5">
        Every habit begins with a <span class="em-serif text-amber-400 text-4xl sm:text-6xl md:text-7xl">single</span> conscious tap.
      </h2>
      <p class="text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Most counters are either rigid spreadsheets or bloated trackers. Keisuki strips away friction, delivering spring-physics feedback and focused micro-interactions right at your fingertips.
      </p>
    </div>

    <!-- Live Interactive Simulator Widget Isle -->
    <div class="relative z-10 max-w-lg mx-auto w-full">
      <InteractiveCounterDemo client:visible />
    </div>
  </div>
</section>
