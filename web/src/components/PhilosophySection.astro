---
import InteractiveCounterDemo from './isles/InteractiveCounterDemo';
import { Vibrate, Compass, ShieldCheck } from 'lucide-react';
---

<section id="showcase" class="min-h-screen py-24 sm:py-32 px-4 sm:px-8 relative flex flex-col justify-center border-t border-white/5 bg-obsidian-950/60">
  <div class="max-w-7xl mx-auto w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      
      <!-- Left Column: Storytelling & Sensory Pillars -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <h2 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-[1.15] mb-5">
            Every habit begins with a <span class="em-serif text-amber-400 text-4xl sm:text-6xl md:text-7xl">single</span> conscious tap.
          </h2>
          <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-normal">
            Most habit trackers demand too much—endless menus, cluttered forms, and notification noise. Keisuki strips tallying down to its purest essence: an instant, satisfying ritual that honors your momentum.
          </p>
        </div>

        <!-- 3 Sensory Pillars -->
        <div class="space-y-4 pt-2">
          
          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <div class="p-2 rounded-xl bg-ruby-500/10 text-ruby-400 flex-shrink-0 mt-0.5">
              <Vibrate className="w-4 h-4" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white mb-1">Satisfying Physicality</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Tuned haptic pulses and micro-audio ticks for every milestone make tallying physically tangible.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 flex-shrink-0 mt-0.5">
              <Compass className="w-4 h-4" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white mb-1">Unbroken Flow</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                Instant single-hand reach controls designed for natural thumb sweeps keep you in your rhythm.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-2xl bg-white/[0.02] border border-white/5">
            <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 flex-shrink-0 mt-0.5">
              <ShieldCheck className="w-4 h-4" />
            </div>
            <div>
              <h3 class="text-sm font-bold text-white mb-1">Absolute Privacy</h3>
              <p class="text-xs text-zinc-400 leading-relaxed">
                100% offline-first storage where your counts and timestamp events never leave your device uninvited.
              </p>
            </div>
          </div>

        </div>

        <p class="text-xs text-zinc-500 italic">
          Try tapping the counter button or changing step sizes on the right to test the physics.
        </p>
      </div>

      <!-- Right Column: Architectural Wireframe Phone Mockup -->
      <div class="lg:col-span-6 flex justify-center items-center">
        <InteractiveCounterDemo client:visible />
      </div>

    </div>
  </div>
</section>
