---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Download, CheckCircle2 } from 'lucide-react';

const RELEASES = [
  {
    version: 'v1.0.0',
    date: 'September 2026',
    title: 'Initial Production Release',
    highlights: [
      'Bento Grid multi-counter home screen with dynamic layout controls.',
      'Dedicated Focus Mode with spring morph buttons and digit roll animations.',
      'High-performance Canvas charting engine with touch scrubber pill.',
      'Offline-first Room SQLite storage with 1500ms debounced Firestore cloud synchronization.',
      'Ergonomic hand-dominance layout options and multi-tier tactile haptics.',
      'AMOLED true black theme and Material 3 Expressive dynamic corner radius.',
    ],
    downloadUrl: 'https://github.com/hi-ashwinsharma/Keisuki/releases',
  },
];
---

<BaseLayout
  title="Changelog - Keisuki Release History"
  description="Release notes and version history for the Keisuki Android application."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-24">
    <!-- Header (No pills above) -->
    <div class="mb-12 border-b border-white/5 pb-8">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
        Keisuki <span class="em-serif text-ruby-400 text-4xl sm:text-6xl">Changelog</span>
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
        Stay updated with the latest enhancements, performance optimizations, and feature updates.
      </p>
    </div>

    <!-- Release List -->
    <div class="space-y-8">
      {RELEASES.map((rel) => (
        <div class="p-8 rounded-3xl glass-panel border border-white/10 bg-obsidian-850 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/5">
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-xl bg-ruby-500/20 text-ruby-400 font-bold num-mono text-sm border border-ruby-500/30">
                {rel.version}
              </span>
              <h2 class="text-lg font-bold text-white">{rel.title}</h2>
            </div>
            <span class="text-xs text-zinc-500 num-mono">{rel.date}</span>
          </div>

          <ul class="space-y-3 text-xs sm:text-sm text-zinc-300">
            {rel.highlights.map((h) => (
              <li class="flex items-start gap-2.5">
                <CheckCircle2 className="w-4 h-4 text-amber-400 flex-shrink-0 mt-0.5" />
                <span>{h}</span>
              </li>
            ))}
          </ul>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between">
            <a
              href={rel.downloadUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white text-xs font-semibold border border-white/10 transition-all hover:border-white/20"
            >
              <Download className="w-3.5 h-3.5 text-amber-400" />
              <span>Download {rel.version} APK</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
